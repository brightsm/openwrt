--- a/lib/c-stack.c
+++ b/lib/c-stack.c
@@ -52,7 +52,10 @@
 #ifndef SIGSTKSZ
 # define SIGSTKSZ 16384
-#elif HAVE_LIBSIGSEGV && SIGSTKSZ < 16384
+#elif HAVE_LIBSIGSEGV

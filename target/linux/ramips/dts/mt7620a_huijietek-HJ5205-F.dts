/dts-v1/;

#include "mt7620a.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "huijietek,hj5205-f", "mediatek,mt7620a";
	model = "Huijietek HJ5205-F";

	chosen {
		bootargs = "console=ttyS0,57600";
	};

	leds {
		compatible = "gpio-leds";
		power {
			label = "hj5205-f:green:power";
			gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
		};
		usb {
			label = "hj5205-f:green:usb";
			gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
		};
		air {
			label = "hj5205-f:green:wifi";
			gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>; /* 注意：原为 <&gpio3 0 1> 表示 active high */
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "Reset button";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		};
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;
			};

			firmware: partition@50000 {
				label = "firmware";
				reg = <0x50000 0xfb0000>;
			};
		};
	};
};

&sdhci {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&ethernet {
	mtd-mac-address = <&factory 0x4>;
	mediatek,port-map = "wllll";
};

&wmac {
	mediatek,mtd-eeprom = <&factory 0>;
};

&pinctrl {
	state_default: pinctrl0 {
		gpio {
			ralink,group = "i2c", "uartf", "wled", "spiclk", "pa";
			ralink,function = "gpio";
		};
	};
};

&pcie {
	status = "okay";
};

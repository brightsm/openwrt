--- a/drivers/usb/serial/option.c
+++ b/drivers/usb/serial/option.c
@@ -2037,6 +2037,17 @@ static int option_probe(struct usb_serial *serial,
 	if (iface_desc->bInterfaceClass == 0x08)
 		return -ENODEV;
 
+    /* Add ZTE ME3760 NDIS interface filtering */
+	#define ZTE_VENDOR_ID  0x19D2
+	#define ZTE_PRODUCT_ME3760 0x0199
+
+	if (dev_desc->idVendor == cpu_to_le16(ZTE_VENDOR_ID) &&
+	    dev_desc->idProduct == cpu_to_le16(ZTE_PRODUCT_ME3760) &&
+	    iface_desc->bInterfaceNumber == 1) {
+		dev_info(&serial->dev->dev, "Skipping NDIS interface for ZTE ME3760\n");
+		return -ENODEV;
+	}
+
